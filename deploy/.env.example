# Settings for deploy/compose.yaml. Copy this file to deploy/.env and fill it
# in; deploy/.env is not tracked because it holds the LiveKit API secret.

# The domain visitors reach the server at. Caddy gets its certificate; with
# localhost, Caddy uses its own local authority (browsers warn).
FALKY_DOMAIN=localhost

# The IP address clients send voice and screen-share media to: the host's
# public address. 127.0.0.1 works for a browser on this machine.
LIVEKIT_NODE_IP=127.0.0.1

# The key pair LiveKit and the server share. The secret must be at least 32
# characters; letters and digits only. For example:
#   echo "FALKY_LIVEKIT_API_KEY=falky$(openssl rand -hex 6)"
#   echo "FALKY_LIVEKIT_API_SECRET=$(openssl rand -hex 32)"
FALKY_LIVEKIT_API_KEY=
FALKY_LIVEKIT_API_SECRET=

# Same-VPS production: falky / falky.lunari.win / ports 7881,7882.
# Development: falky-dev / dev.falky.lunari.win / ports 7891,7892.
# Staging: falky-staging / staging.falky.lunari.win / ports 7901,7902.
# Each instance needs fresh LiveKit credentials and its own private .env.
# Never rename the production project: its name selects the existing volumes.
FALKY_PROJECT_NAME=falky
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# VPS only: host-owned network (defaults to <project>_default).
# FALKY_NETWORK=falky_default
# Image selections are managed in the release manifest, not in this settings file.

# Posted attachment bytes across all rooms; staging and conversion scratch are separate.
# Keep the attachment root on the durable /data mount. Snapshots exclude file contents.
FALKY_ATTACHMENT_POSTED_BYTES=5000000000
FALKY_ATTACHMENT_ROOT=/data/attachments
