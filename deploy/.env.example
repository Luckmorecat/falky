# Settings for deploy/compose.yaml. Copy this file to deploy/.env and fill it
# in; deploy/.env is not tracked because it holds the LiveKit API secret.

# The domain visitors reach the server at. Caddy gets its certificate; with
# localhost, Caddy uses its own local authority (browsers warn).
FALKY_DOMAIN=localhost

# The IP address clients send voice and screen-share media to: the host's
# public address. 127.0.0.1 works for a browser on this machine.
LIVEKIT_NODE_IP=127.0.0.1

# The key pair LiveKit and the server share. The secret must be at least 32
# characters; letters and digits only. For example:
#   echo "FALKY_LIVEKIT_API_KEY=falky$(openssl rand -hex 6)"
#   echo "FALKY_LIVEKIT_API_SECRET=$(openssl rand -hex 32)"
FALKY_LIVEKIT_API_KEY=
FALKY_LIVEKIT_API_SECRET=
