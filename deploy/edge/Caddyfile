# Only this container publishes HTTP(S). Do not trust client-supplied forwarded
# headers: Falky's per-address entry limit uses the IP set by this proxy.
(instance) {
	handle /api/* {
		reverse_proxy {args[0]}-api:8080
	}
	@rtc path /rtc /rtc/*
	handle @rtc {
		reverse_proxy {args[0]}-voice:7880
	}
	handle {
		reverse_proxy {args[0]}-web:80
	}
}

falky.lunari.win {
	import instance falky
}

dev.falky.lunari.win {
	import instance falky-dev
}
