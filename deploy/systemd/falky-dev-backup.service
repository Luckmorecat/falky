[Unit]
Description=Falky development database snapshot and deployment configuration backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deployer
Group=deployer
SupplementaryGroups=docker
WorkingDirectory=/srv/falky-dev
Environment=FALKY_LOCK_WAIT_SECONDS=900
ExecStart=/srv/falky-dev/manage.sh backup
UMask=0077
# Allow fifteen minutes for the lock, then five minutes to write/copy backup.
TimeoutStartSec=1200
