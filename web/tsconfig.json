{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@falky/browser": ["./src/runtime/browser.ts"],
      "@falky/voice": ["./src/voice/session.ts"],
      "@falky/bootstrap": ["./src/runtime/bootstrap.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
