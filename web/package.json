{
  "name": "falky-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.mock.json",
    "test": "vitest run",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "dev:mock": "tsx mock/dev.ts",
    "test:mock": "tsx --test mock/*.test.ts",
    "test:browser": "playwright test",
    "test:runtime": "tsx scripts/check-runtime.ts",
    "screenshot:mock": "node --import tsx scripts/screenshot-mock.ts",
    "test:screenshot": "node --import tsx --test scripts/screenshot-mock.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "livekit-client": "2.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
